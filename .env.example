# =============================================================================
# MedVoice AI HMS — Docker Compose environment
# Copy to .env in the repository root before running: docker compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Public HTTP port (Nginx reverse proxy)
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=80

# -----------------------------------------------------------------------------
# PostgreSQL (persistent volume: postgres_data)
# -----------------------------------------------------------------------------
POSTGRES_USER=medvoice
POSTGRES_PASSWORD=medvoice_pg_8f3k2n9x
POSTGRES_DB=medvoice

# -----------------------------------------------------------------------------
# Redis (persistent volume: redis_data)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=medvoice_redis_7h2m4p1q

# -----------------------------------------------------------------------------
# MinIO S3-compatible object storage (persistent volume: minio_data)
# Console: http://localhost:9001 (when MINIO_CONSOLE_PORT is published)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=medvoice_minio
MINIO_ROOT_PASSWORD=medvoice_minio_9j5k8w2z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_VOICE=medvoice-voice-recordings
MINIO_BUCKET_TRANSCRIPTION=medvoice-transcription-audio
MINIO_BUCKET_DOCUMENTS=medvoice-documents

# -----------------------------------------------------------------------------
# Backend application
# -----------------------------------------------------------------------------
APP_NAME=MedVoice AI HMS
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# Comma-separated origins allowed by CORS (use your public URL in production)
CORS_ORIGINS=http://localhost

# JWT — generate a unique secret: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-output
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh token cookie (same-origin via Nginx — secure=true when TLS terminates upstream)
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
REFRESH_TOKEN_COOKIE_DOMAIN=
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax

BCRYPT_ROUNDS=12

# Run idempotent seed on container start (set false after first successful deploy)
SEED_DATABASE=true
SEED_ADMIN_EMAIL=admin@medvoice.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_FULL_NAME=System Administrator

# Uvicorn worker processes (2 × CPU cores is a common starting point)
UVICORN_WORKERS=2

# Local filesystem storage (mounted volume: backend_storage)
VOICE_RECORDINGS_DIR=storage/voice_recordings
TRANSCRIPTION_AUDIO_DIR=storage/transcription_audio
MAX_VOICE_RECORDING_SIZE_MB=100
MAX_TRANSCRIPTION_UPLOAD_MB=100
AI_SETTINGS_PATH=storage/ai_settings.json

# OpenAI — required for AI transcription and clinical note generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
TEMPERATURE=0.7
MAX_TOKENS=2048

# Infrastructure URLs (services on medvoice-net — ready for future integration)
REDIS_URL=redis://:medvoice_redis_7h2m4p1q@redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=medvoice_minio
S3_SECRET_KEY=medvoice_minio_9j5k8w2z
S3_REGION=us-east-1
S3_BUCKET_VOICE=medvoice-voice-recordings
S3_BUCKET_TRANSCRIPTION=medvoice-transcription-audio
S3_BUCKET_DOCUMENTS=medvoice-documents
S3_USE_SSL=false

# -----------------------------------------------------------------------------
# Frontend build (baked into image at build time)
# Relative path keeps API on the same origin as the SPA via Nginx.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1

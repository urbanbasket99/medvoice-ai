# MedVoice AI HMS — Docker Compose environment (backend-only overrides)
# Used when running the API outside Docker but connecting to compose services.
# For full stack deployment, use the root .env.example instead.

APP_NAME=MedVoice AI HMS
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

CORS_ORIGINS=http://localhost:5173,http://localhost

DATABASE_URL=postgresql+asyncpg://medvoice:medvoice_pg_8f3k2n9x@localhost:5432/medvoice

JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-output
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
REFRESH_TOKEN_COOKIE_DOMAIN=
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax

BCRYPT_ROUNDS=12

VOICE_RECORDINGS_DIR=storage/voice_recordings
TRANSCRIPTION_AUDIO_DIR=storage/transcription_audio
MAX_VOICE_RECORDING_SIZE_MB=100
MAX_TRANSCRIPTION_UPLOAD_MB=100
AI_SETTINGS_PATH=storage/ai_settings.json

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
TEMPERATURE=0.7
MAX_TOKENS=2048

REDIS_URL=redis://:medvoice_redis_7h2m4p1q@localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=medvoice_minio
S3_SECRET_KEY=medvoice_minio_9j5k8w2z
S3_REGION=us-east-1
S3_BUCKET_VOICE=medvoice-voice-recordings
S3_BUCKET_TRANSCRIPTION=medvoice-transcription-audio
S3_BUCKET_DOCUMENTS=medvoice-documents
S3_USE_SSL=false
